<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Redis without JedisSource (removed in Rahla 1.3.6): Jedis is a proper OSGi bundle, it just needs
  its four runtime dependencies next to it. dependency="true" lets Karaf reuse a commons-pool2 / gson
  that another feature (Camel) already installed instead of starting a second copy.
-->
<features xmlns="http://karaf.apache.org/xmlns/features/v1.6.0" name="redis-example">
  <feature name="redis-example" version="1" install="auto">
    <feature>camel-blueprint</feature>
    <feature>camel-jetty</feature>   <!-- REST endpoint of the example only -->
    <bundle dependency="true">mvn:org.apache.commons/commons-pool2/2.12.1</bundle>
    <bundle dependency="true">mvn:com.google.code.gson/gson/2.13.2</bundle>
    <bundle>mvn:org.json/json/20251224</bundle>
    <bundle>mvn:redis.clients.authentication/redis-authx-core/0.1.1-beta2</bundle>
    <bundle>mvn:redis.clients/jedis/7.5.3</bundle>
  </feature>
</features>
